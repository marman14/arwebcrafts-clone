# =====================================================================
# AR Webcrafts LLC - Stripe Payment Gateway Configuration
# =====================================================================
# In production on Vercel, set these in: Project Settings -> Environment Variables.
# For local testing, copy this file to .env and insert your real Stripe keys.

# Stripe Publishable Key (Frontend Safe)
# Obtain from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Stripe Secret Key (Server-only / NEVER expose in client-side HTML or JS)
# Obtain from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe Webhook Signing Secret (Optional but recommended for verifying webhook events)
# Obtain from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Website Base URL for Checkout Redirects (Success & Cancel)
SITE_URL=https://arwebcrafts-clone.vercel.app
