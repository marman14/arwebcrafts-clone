{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^arwebcrafts\\.com$"
        }
      ],
      "destination": "https://www.arwebcrafts.com/:path*",
      "permanent": true
    },
    {
      "source": "/hire-a-full-stack-wordpress-developer",
      "destination": "/staff-augmentation/",
      "permanent": true
    },
    {
      "source": "/hire-a-full-stack-wordpress-developer/",
      "destination": "/staff-augmentation/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about-us/",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/about-us/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact-us/",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact-us/",
      "permanent": true
    },
    {
      "source": "/white-label",
      "destination": "/agency-partner/",
      "permanent": true
    },
    {
      "source": "/white-label/",
      "destination": "/agency-partner/",
      "permanent": true
    },
    {
      "source": "/partner",
      "destination": "/agency-partner/",
      "permanent": true
    },
    {
      "source": "/partner/",
      "destination": "/agency-partner/",
      "permanent": true
    },
    {
      "source": "/work-with-us",
      "destination": "/agency-partner/",
      "permanent": true
    },
    {
      "source": "/work-with-us/",
      "destination": "/agency-partner/",
      "permanent": true
    },
    {
      "source": "/white-label-development-partner",
      "destination": "/agency-partner/",
      "permanent": true
    },
    {
      "source": "/white-label-development-partner/",
      "destination": "/agency-partner/",
      "permanent": true
    },
    {
      "source": "/sitemap.rss/",
      "destination": "/sitemap.rss",
      "permanent": true
    },
    {
      "source": "/sitemap.xml/",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml/",
      "destination": "/sitemap_index.xml",
      "permanent": true
    },
    {
      "source": "/page-sitemap.xml/",
      "destination": "/page-sitemap.xml",
      "permanent": true
    },
    {
      "source": "/post-sitemap.xml/",
      "destination": "/post-sitemap.xml",
      "permanent": true
    },
    {
      "source": "/robots.txt/",
      "destination": "/robots.txt",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\")"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https://api.stripe.com https://*.vercel.app https://*.vercel.com https://*.vercel-scripts.com https://*.vercel-insights.com https://vercel.live wss://*.vercel.com wss://vercel.live https://arwebcrafts.com https://www.arwebcrafts.com https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://assets.calendly.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://calendly.com https://www.youtube.com https://player.vimeo.com https://*.vercel.app https://*.vercel.com https://vercel.live; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:; style-src 'self' 'unsafe-inline' https: data:;"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:ico|png|jpg|jpeg|gif|svg|webp|avif|woff|woff2|ttf|eot|otf))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wp-content/litespeed/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wp-content/(.*\\.(?:css|js))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/wp-includes/(.*\\.(?:css|js))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(ar-global-enhancements\\.(?:css|js))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sitemap.rss",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*sitemap.*\\.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "outputDirectory": "."
}